{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:style": "stylelint \"src/**/*.scss\" --fix",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,scss,json}\"",
    "format": "npm run prettier && npm run lint && npm run lint:style",
    "test": "jest --config=./jest.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test",
    "preview": "vite preview",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start:mock": "json-server --watch src/mock/data/diseases.json src/mock/data/riskFactors.json src/mock/data/symptoms.json src/mock/data/sources.json --routes src/mock/data/routes.json --port 4000"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix"
    ],
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react": "^9.44.0",
    "@uiw/react-md-editor": "^4.0.8",
    "axios": "^1.10.0",
    "classnames": "^2.5.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.561.0",
    "motion": "^12.23.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.7.0",
    "react-virtualized": "^9.22.6",
    "sass": "^1.89.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.29.0",
    "@storybook/addon-a11y": "^10.1.8",
    "@storybook/addon-docs": "^10.1.8",
    "@storybook/addon-vitest": "^10.1.8",
    "@storybook/react-vite": "^10.1.8",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/classnames": "^2.3.4",
    "@types/jest": "^30.0.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-virtualized": "^9.22.2",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.1.8",
    "eslint-plugin-unicorn": "^50.0.1",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "jest-transform-stub": "^2.0.0",
    "json-server": "^0.17.4",
    "lint-staged": "^16.1.2",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.1",
    "storybook": "^10.1.8",
    "stylelint": "^16.21.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "ts-jest": "^29.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.15"
  }
}
